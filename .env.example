# Server-side Gemini API key. Configure this in Vercel Environment Variables.
GOOGLE_GEMINI_API=

# --- Notifikasi harian 09:00 WIB (Web Push) ---
# Buat sendiri dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Rahasia untuk endpoint cron (acak, 16+ karakter). Vercel mengirimnya otomatis sebagai Authorization: Bearer
CRON_SECRET=
# Redis (otomatis terisi saat Upstash Redis dihubungkan lewat Vercel Storage/Marketplace):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
